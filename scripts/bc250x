#!/bin/sh
# bc250x — BC-250-X CLI. Same safety gates as the GUI. No bypass flag exists.
# Usage: bc250x status | backup [dest] | verify <file> | catalog | diag
#        bc250x flash <file>   (stages Flash Mode; never writes directly from here)
#        bc250x pray <preset.rom> [backup-dest]   (Flash & Pray: backup -> verify -> stage the Fanalogy preset)
set -eu
CONF="${BC250X_CONF:-/usr/share/bc250x/bc250x.conf}"
[ -f "$CONF" ] && . "$CONF"
EXPECTED_BIOS_SIZE="${EXPECTED_BIOS_SIZE:-16777216}"
WHITELIST="${CHIP_WHITELIST:-W25Q128JVSQ MX25L12835F MX25L12873F}"
BLACKLIST="${CHIP_BLACKLIST:-MX25L4005A}"

sha() { sha256sum "$1" | awk '{print $1}'; }

cmd_status() {
  echo "== BC-250-X status =="
  grep -m1 'model name' /proc/cpuinfo || true
  echo "Cores: $(nproc 2>/dev/null || grep -c ^processor /proc/cpuinfo)  CPUs online: $(grep -c ^processor /proc/cpuinfo)"
  for d in /sys/class/dmi/id; do
    echo "Board: $(cat $d/product_name 2>/dev/null)  BIOS: $(cat $d/bios_version 2>/dev/null) $(cat $d/bios_date 2>/dev/null)"
  done
  for z in /sys/class/hwmon/hwmon*; do
    n=$(cat "$z/name" 2>/dev/null || true)
    for t in "$z"/temp*_input; do [ -f "$t" ] && echo "$n $(basename "$t"): $(( $(cat "$t") / 1000 )) C"; done
    for p in "$z"/power*_average; do [ -f "$p" ] && echo "$n power avg: $(( $(cat "$p") / 1000000 )) W (uncalibrated)"; done
  done
  echo "Kernel: $(uname -r)  (guardrail: avoid 6.15.0-6.15.6, 6.17.8-6.17.10)"
  command -v sensors >/dev/null && sensors || true
}

probe_chip() {
  command -v flashrom >/dev/null || { echo "flashrom not installed" >&2; return 1; }
  flashrom -p internal 2>&1 | tee /tmp/bc250x-probe.log
  if grep -q "$BLACKLIST" /tmp/bc250x-probe.log; then
    echo "ABORT: probe matched the SuperIO chip ($BLACKLIST). Refusing all write paths." >&2; return 2
  fi
}

cmd_verify() {
  f="$1"; [ -f "$f" ] || { echo "no such file: $f" >&2; exit 1; }
  sz=$(stat -c%s "$f")
  echo "file: $f"; echo "size: $sz (expected $EXPECTED_BIOS_SIZE)"; echo "sha256: $(sha "$f")"
  [ "$sz" = "$EXPECTED_BIOS_SIZE" ] || { echo "FAIL: wrong size — not a BC-250 BIOS image." >&2; exit 1; }
  echo "OK: size gate passed. Compare the hash above to the signed catalog before flashing."
}

cmd_backup() {
  dest="${1:-.}"; mkdir -p "$dest"
  probe_chip
  out="$dest/BC250-backup-$(date +%Y%m%d-%H%M%S).bin"
  echo "Reading flash twice (both reads must hash identically)…"
  flashrom -p internal -r "$out.tmp1"
  flashrom -p internal -r "$out.tmp2"
  h1=$(sha "$out.tmp1"); h2=$(sha "$out.tmp2")
  [ "$h1" = "$h2" ] || { echo "ABORT: the two reads differ ($h1 vs $h2). Backup NOT trusted." >&2; rm -f "$out.tmp1" "$out.tmp2"; exit 1; }
  [ "$(stat -c%s "$out.tmp1")" = "$EXPECTED_BIOS_SIZE" ] || { echo "ABORT: backup size is not 16 MB." >&2; exit 1; }
  mv "$out.tmp1" "$out"; rm -f "$out.tmp2"
  echo "{\"sha256\":\"$h1\",\"size\":$EXPECTED_BIOS_SIZE,\"date\":\"$(date -Iseconds)\"}" > "$out.json"
  echo "Verified backup: $out  sha256=$h1"
}

cmd_flash() {
  f="$1"; cmd_verify "$f"
  echo "Gate 2/3: a verified backup is required. Gate 3/3: type FLASH to stage Flash Mode."
  printf "Type FLASH: "; read -r a; [ "$a" = "FLASH" ] || { echo "Aborted."; exit 1; }
  echo "Staging image + Flash.nsh to ESP staging dir (BC250X_EFI_STAGE, default /boot/efi/bc250x-flash)…"
  stage="${BC250X_EFI_STAGE:-/boot/efi/bc250x-flash}"; mkdir -p "$stage"
  cp "$f" "$stage/BC250X.ROM"
  echo "Staged. Reboot into Flash Mode (systemd-boot entry 'BC-250-X Flash Mode') to run AfuEfix64."
  echo "BC-250-X does not write the BIOS directly from Linux on this board — the UEFI-shell flow is the proven path."
}

cmd_pray() {
  img="${1:-}"
  echo "== BC-250-X Flash & Pray — Fanalogy Nirvana preset =="
  echo "Sequence: verified backup + settings snapshot -> preset verify -> stage Flash Mode."
  echo "The preset unlocks all 8 cores / 16 threads, the Nirvana boot logo, and Fanalogy"
  echo "presets (IOMMU off, VRAM 512MB dynamic). The 40-CU GPU unlock is OS-level, not"
  echo "firmware — BC-250-X offers it after a verified first boot, with stability fallback."
  cat_file="${BC250X_CATALOG_DIR:-/usr/share/bc250x}/bios.json"
  [ -f "$cat_file" ] || { echo "ABORT: no local catalog at $cat_file — fetch the catalogs first (GUI, or 'bc250x catalog' with network)." >&2; exit 1; }
  entry=$(grep -o '"id":"fanalogy-p300-nirvana-preset"[^}]*}' "$cat_file" || true)
  [ -n "$entry" ] || { echo "ABORT: preset entry fanalogy-p300-nirvana-preset not found in catalog." >&2; exit 1; }
  want=$(printf '%s' "$entry" | sed -n 's/.*"sha256":"\([^"]*\)".*/\1/p')
  case "$want" in
    PENDING*|"") echo "ABORT: the Fanalogy preset is not published yet (catalog hash pending)." >&2
      echo "Flash & Pray unlocks when a real preset image is built, hashed and minisign-signed." >&2; exit 1 ;;
  esac
  [ -n "$img" ] || { echo "usage: bc250x pray <preset.rom> [backup-dest]" >&2; exit 2; }
  dest="${2:-./bc250x-pray-backup}"; mkdir -p "$dest"
  echo "-- Step 1/3: backup current BIOS (read twice, hashes must match) + settings snapshot"
  cmd_status > "$dest/settings-before.txt" 2>&1 || true
  command -v efibootmgr >/dev/null && efibootmgr -v > "$dest/efibootmgr-before.txt" 2>&1 || true
  cmd_backup "$dest"
  echo "-- Step 2/3: verify preset image against the signed catalog"
  cmd_verify "$img"
  got=$(sha "$img")
  [ "$got" = "$want" ] || { echo "ABORT: image hash $got does not match catalog $want. Refusing." >&2; exit 1; }
  echo "Hash matches the signed catalog."
  echo "-- Step 3/3: stage Flash Mode"
  printf "Type PRAY to stage the flash: "; read -r a; [ "$a" = "PRAY" ] || { echo "Aborted. Backup kept at $dest — nothing was staged."; exit 1; }
  stage="${BC250X_EFI_STAGE:-/boot/efi/bc250x-flash}"; mkdir -p "$stage"
  cp "$img" "$stage/BC250X.ROM"
  echo "Staged. Reboot into Flash Mode / the BC-250-X UEFI menu and pick [menu 01]."
  echo "After the flash: remove power, clear CMOS (battery out 60s), then boot BC-250-X to finish the post-flash wizard."
}

cmd_catalog() {
  base="${CATALOG_PRIMARY:-https://raw.githubusercontent.com/chainchopper/BC250-X/main/catalog}"
  for c in bios.json os.json tools.json; do echo "--- $c ($base/$c)"; curl -fsSL "$base/$c" | head -c 600; echo; done
}

cmd_diag() { echo "Quick diag:"; cmd_status; command -v smartctl >/dev/null && smartctl --scan || true; echo "Full diag (memtest/stress) runs from the GUI Diagnostics screen."; }

case "${1:-status}" in
  status) cmd_status ;;
  backup) cmd_backup "${2:-.}" ;;
  verify) cmd_verify "$2" ;;
  flash)  cmd_flash "$2" ;;
  pray)   cmd_pray "${2:-}" "${3:-}" ;;
  catalog) cmd_catalog ;;
  diag) cmd_diag ;;
  *) echo "usage: bc250x status|backup [dest]|verify <file>|flash <file>|pray <preset.rom> [backup-dest]|catalog|diag" >&2; exit 2 ;;
esac
