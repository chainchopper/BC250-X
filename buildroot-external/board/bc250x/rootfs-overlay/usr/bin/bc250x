#!/bin/sh
# bc250x — BC-250-X CLI. Same safety gates as the GUI. No bypass flag exists.
# Usage: bc250x status | backup [dest] | verify <file> | catalog | diag
#        bc250x flash <file>   (stages Flash Mode; never writes directly from here)
#        bc250x pray <preset.rom> [backup-dest]   (Flash & Pray: backup -> verify -> stage the Fanalogy preset)
set -eu
CONF="${BC250X_CONF:-/usr/share/bc250x/bc250x.conf}"
[ -f "$CONF" ] && . "$CONF"
EXPECTED_BIOS_SIZE="${EXPECTED_BIOS_SIZE:-16777216}"
WHITELIST="${CHIP_WHITELIST:-W25Q128JVSQ MX25L12835F MX25L12873F}"
BLACKLIST="${CHIP_BLACKLIST:-MX25L4005A}"

sha() { sha256sum "$1" | awk '{print $1}'; }

cmd_status() {
  echo "== BC-250-X status =="
  grep -m1 'model name' /proc/cpuinfo || true
  echo "Cores: $(nproc 2>/dev/null || grep -c ^processor /proc/cpuinfo)  CPUs online: $(grep -c ^processor /proc/cpuinfo)"
  for d in /sys/class/dmi/id; do
    echo "Board: $(cat $d/product_name 2>/dev/null)  BIOS: $(cat $d/bios_version 2>/dev/null) $(cat $d/bios_date 2>/dev/null)"
  done
  for z in /sys/class/hwmon/hwmon*; do
    n=$(cat "$z/name" 2>/dev/null || true)
    for t in "$z"/temp*_input; do [ -f "$t" ] && echo "$n $(basename "$t"): $(( $(cat "$t") / 1000 )) C"; done
    for p in "$z"/power*_average; do [ -f "$p" ] && echo "$n power avg: $(( $(cat "$p") / 1000000 )) W (uncalibrated)"; done
  done
  echo "Kernel: $(uname -r)  (guardrail: avoid 6.15.0-6.15.6, 6.17.8-6.17.10)"
  command -v sensors >/dev/null && sensors || true
}

probe_chip() {
  command -v flashrom >/dev/null || { echo "flashrom not installed" >&2; return 1; }
  flashrom -p internal 2>&1 | tee /tmp/bc250x-probe.log
  if grep -q "$BLACKLIST" /tmp/bc250x-probe.log; then
    echo "ABORT: probe matched the SuperIO chip ($BLACKLIST). Refusing all write paths." >&2; return 2
  fi
}

cmd_verify() {
  f="$1"; [ -f "$f" ] || { echo "no such file: $f" >&2; exit 1; }
  sz=$(stat -c%s "$f")
  echo "file: $f"; echo "size: $sz (expected $EXPECTED_BIOS_SIZE)"; echo "sha256: $(sha "$f")"
  [ "$sz" = "$EXPECTED_BIOS_SIZE" ] || { echo "FAIL: wrong size — not a BC-250 BIOS image." >&2; exit 1; }
  echo "OK: size gate passed. Compare the hash above to the signed catalog before flashing."
}

cmd_backup() {
  dest="${1:-.}"; mkdir -p "$dest"
  probe_chip
  out="$dest/BC250-backup-$(date +%Y%m%d-%H%M%S).bin"
  echo "Reading flash twice (both reads must hash identically)…"
  flashrom -p internal -r "$out.tmp1"
  flashrom -p internal -r "$out.tmp2"
  h1=$(sha "$out.tmp1"); h2=$(sha "$out.tmp2")
  [ "$h1" = "$h2" ] || { echo "ABORT: the two reads differ ($h1 vs $h2). Backup NOT trusted." >&2; rm -f "$out.tmp1" "$out.tmp2"; exit 1; }
  [ "$(stat -c%s "$out.tmp1")" = "$EXPECTED_BIOS_SIZE" ] || { echo "ABORT: backup size is not 16 MB." >&2; exit 1; }
  mv "$out.tmp1" "$out"; rm -f "$out.tmp2"
  echo "{\"sha256\":\"$h1\",\"size\":$EXPECTED_BIOS_SIZE,\"date\":\"$(date -Iseconds)\"}" > "$out.json"
  echo "Verified backup: $out  sha256=$h1"
}

BIOS_JSON() { printf '%s' "${BC250X_CATALOG_DIR:-/usr/share/bc250x}/bios.json"; }

is_live() { [ -f /run/bc250x-live ] || [ -n "${BC250X_LIVE:-}" ]; }

in_catalog() { # $1=image — true when its sha256 appears in bios.json
  h=$(sha "$1"); cf=$(BIOS_JSON)
  [ -f "$cf" ] && grep -q "\"sha256\":\"$h\"" "$cf"
}

entry_hash() { # $1=filename — the sha256 of the catalog entry with that filename
  cf=$(BIOS_JSON); [ -f "$cf" ] || return 1
  seg=$(sed "s/.*\"filename\":\"$1\"//" "$cf" | cut -c1-700)
  printf '%s' "$seg" | sed -n 's/.*"sha256":"\([a-f0-9]\{64\}\)".*/\1/p' | head -1
}

require_backup() { # $1=dest dir — a verified backup must exist; make one if not
  if ls "$1"/BC250-backup-*.bin >/dev/null 2>&1; then
    echo "Verified backup already on record in $1."
  else
    echo "No backup on record — making a verified one now (mandatory before any write)."
    cmd_backup "$1"
  fi
}

do_write() { # $1=image — the actual write, our own flasher (flashrom), full gates
  probe_chip
  grep -Eq 'W25Q128JVSQ|MX25L12835F|MX25L12873F' /tmp/bc250x-probe.log \
    || { echo "ABORT: probe did not identify a whitelisted 16MB BIOS chip. Not writing." >&2; exit 1; }
  echo "Writing with flashrom — DO NOT power off until this finishes."
  flashrom -p internal -w "$1"
  rb="$(dirname "$1")/.bc250x-readback.bin"
  echo "Write reported OK. Read-back verify…"
  flashrom -p internal -r "$rb"
  [ "$(sha "$rb")" = "$(sha "$1")" ] \
    || { echo "ABORT: read-back hash differs from the image. Board state is UNKNOWN — restore the verified backup before rebooting." >&2; exit 1; }
  rm -f "$rb"
  echo "Read-back verified: the chip now matches the image byte-for-byte."
}

apply_presets() { # Fanalogy safe presets: governor safe-points + post-flash checks
  echo "== Fanalogy safe presets =="
  govdir=/etc/cyan-skillfish-governor
  if [ -d "$govdir" ]; then
    printf '[gpu]\nmin_freq = 500\nmax_freq = 1500\n\n[[gpu.safe_points]]\nfreq = 1500\nvoltage = 900\n' > "$govdir/config.toml"
    echo "Governor safe-points applied: 1500 MHz cap @ 900 mV (the community-safe ceiling)."
  else
    echo "Governor preset (apply in nirvana-config on the installed OS): GPU cap 1500 MHz @ 900 mV."
  fi
  echo "After the mandatory CMOS clear, verify on first boot (BIOS chipset menu):"
  echo "  - IOMMU: Disabled   - VRAM: 512MB Dynamic   - cores: 8C/16T config present"
  echo "CU routing (24->40) and SMU tuning live in nirvana-config: live, health-tested, masked."
}

require_live() {
  is_live || { echo "ABORT: flash writes run from the BC-250-X live ISO / netboot — not from an installed OS." >&2
    echo "Boot the ISO (or stage from the GUI and pick the Flash Mode boot entry), then run this again." >&2; exit 1; }
}

cmd_flash() {
  f="${1:-}"; [ -n "$f" ] || { echo "usage: bc250x flash <image.rom>" >&2; exit 2; }
  require_live
  echo "== BC-250-X flash =="
  cmd_verify "$f"
  if in_catalog "$f"; then
    echo "Catalog: this image's hash is in the BC-250-X catalog."
  else
    echo "WARNING: this image is NOT in the catalog. sha256: $(sha "$f")"
    printf "Type the first 8 chars of that hash to confirm you mean THIS file: "; read -r a
    [ "$a" = "$(sha "$f" | cut -c1-8)" ] || { echo "Aborted."; exit 1; }
  fi
  dest="${BC250X_BACKUP_DIR:-./bc250x-backups}"; mkdir -p "$dest"
  require_backup "$dest"
  printf "Type FLASH to write %s now: " "$f"; read -r a
  [ "$a" = "FLASH" ] || { echo "Aborted — backup kept, nothing written."; exit 1; }
  do_write "$f"
  echo "FLASH COMPLETE. Next: remove power, clear CMOS (battery out 60s), boot, verify settings."
}

cmd_flashmode() { # Flash Mode boot entry: write the GUI-staged image
  stage="${BC250X_EFI_STAGE:-/boot/efi/bc250x-flash}"
  img="$stage/BC250X.ROM"
  [ -f "$img" ] || { echo "Flash Mode: no staged image at $img — nothing to do."; exit 0; }
  echo "Flash Mode: staged image found."
  cmd_flash "$img"
}

cmd_pray() {
  dest="${1:-./bc250x-pray-backup}"
  echo "== BC-250-X Flash & Pray =="
  echo "Flash & Pray is simply the recommended flash, run with Fanalogy's safe presets:"
  echo "verified backup -> P3.00 Chipset BIOS (catalog) -> our writer -> preset checklist."
  echo "Same gates as the manual flow — fewer steps, not fewer checks."
  require_live
  img=""
  for d in "${BC250X_PAYLOAD_DIR:-}" /usr/share/bc250x/payload ./payload; do
    [ -n "$d" ] && [ -f "$d/BC250_3.00_CHIPSETMENU.ROM" ] && { img="$d/BC250_3.00_CHIPSETMENU.ROM"; break; }
  done
  [ -n "$img" ] || { echo "ABORT: the bundled P3.00 payload was not found on this medium." >&2; exit 1; }
  want=$(entry_hash BC250_3.00_CHIPSETMENU.ROM)
  [ -n "$want" ] || { echo "ABORT: catalog entry/hash for the P3.00 payload is missing." >&2; exit 1; }
  mkdir -p "$dest"
  echo "-- Step 1/3: backup current BIOS (verified) + settings snapshot -> $dest"
  cmd_status > "$dest/settings-before.txt" 2>&1 || true
  command -v efibootmgr >/dev/null && efibootmgr -v > "$dest/efibootmgr-before.txt" 2>&1 || true
  require_backup "$dest"
  echo "-- Step 2/3: verify the target image against the catalog"
  cmd_verify "$img"
  [ "$(sha "$img")" = "$want" ] || { echo "ABORT: payload hash does not match the catalog entry." >&2; exit 1; }
  echo "Catalog hash match."
  echo "-- Step 3/3: write it"
  printf "Type PRAY to flash now: "; read -r a
  [ "$a" = "PRAY" ] || { echo "Aborted — backup kept at $dest, nothing written."; exit 1; }
  do_write "$img"
  apply_presets
  echo "FLASH & PRAY COMPLETE. Next: remove power, clear CMOS (battery out 60s), boot, verify settings."
}

cmd_catalog() {
  base="${CATALOG_PRIMARY:-https://raw.githubusercontent.com/chainchopper/BC250-X/main/catalog}"
  for c in bios.json os.json tools.json; do echo "--- $c ($base/$c)"; curl -fsSL "$base/$c" | head -c 600; echo; done
}

cmd_diag() { echo "Quick diag:"; cmd_status; command -v smartctl >/dev/null && smartctl --scan || true; echo "Full diag (memtest/stress) runs from the GUI Diagnostics screen."; }

case "${1:-status}" in
  status) cmd_status ;;
  backup) cmd_backup "${2:-.}" ;;
  verify) cmd_verify "$2" ;;
  flash)  cmd_flash "${2:-}" ;;
  flashmode) cmd_flashmode ;;
  pray)   cmd_pray "${2:-}" ;;
  catalog) cmd_catalog ;;
  diag) cmd_diag ;;
  *) echo "usage: bc250x status|backup [dest]|verify <file>|flash <file>|flashmode|pray [backup-dest]|catalog|diag" >&2; exit 2 ;;
esac
