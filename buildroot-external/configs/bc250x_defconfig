# BC-250-X Buildroot defconfig (skeleton, Phase 1)
BR2_x86_64=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12.0"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_BC250X_PATH)/../../kernel/bc250x-kernel.fragment"
BR2_PACKAGE_SYSTEMD=y
BR2_PACKAGE_SYSTEMD_BOOTCHART=n
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_ISO9660=y
BR2_TARGET_ROOTFS_ISO9660_HYBRID=y
# BC-250-X payload tools
BR2_PACKAGE_FLASHROM=y
BR2_PACKAGE_EFIBOOTMGR=y
BR2_PACKAGE_DMIDECODE=y
BR2_PACKAGE_LM_SENSORS=y
BR2_PACKAGE_SMARTMONTOOLS=y
BR2_PACKAGE_NVME=y
BR2_PACKAGE_FIO=y
BR2_PACKAGE_STRESS_NG=y
BR2_PACKAGE_MEMTESTER=y
BR2_PACKAGE_CURL=y
BR2_PACKAGE_IWD=y
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_MINISIGN=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_BC250X_PATH)/board/bc250x/rootfs-overlay"
